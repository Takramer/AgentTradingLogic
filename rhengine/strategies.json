          "desc": "Prior bar tagged the band; current candle closes back inside."
        }
      ],
      "thresholds": {
        "volMult": {
          "default": 1.1,
          "min": 1.0,
          "max": 2.0,
          "step": 0.05,
          "label": "Volume Threshold"
        },
        "rsiLow": {
          "default": 35,
          "min": 20,
          "max": 45,
          "step": 1,
          "label": "RSI Oversold"
        },
        "rsiHigh": {
          "default": 65,
          "min": 55,
          "max": 80,
          "step": 1,
          "label": "RSI Overbought"
        },
        "adxMax": {
          "default": 35,
          "min": 15,
          "max": 45,
          "step": 1,
          "label": "ADX Trend Gate"
        },
        "stopAtrMult": {
          "default": 1.5,
          "min": 0.5,
          "max": 3.0,
          "step": 0.25,
          "label": "Stop (ATR mult)"
        },
        "targetAtrMult": {
          "default": 1.5,
          "min": 1.0,
          "max": 4.0,
          "step": 0.25,
          "label": "Target (ATR mult)"
        },
        "stageFilter": {
          "default": 0,
          "min": 0,
          "max": 1,
          "step": 1,
          "label": "Stage Filter (150d SMA)"
        }
      }
    },
