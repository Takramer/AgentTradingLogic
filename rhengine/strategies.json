    "consolidation": {
      "id": "consolidation",
      "name": "Consolidation Breakout",
      "retired": true,
      "description": "RETIRED 2026-07-18 per full-matrix ablation: the COMP compression leg is toxic (median PF 0.69 on vs 1.01 off; every COMP combination PF<1 over 730d full market). Kept for manual/research use only; excluded from scan --all. Original: BB + range compression with low ADX, then a confirmed breakout bar with volume; 'held' leg filters single-bar fakeouts.",
      "regime": null,
      "legs": [
