      "legs": [
        {
          "abbr": "BB",
          "full": "Bollinger Bands",
          "desc": "Price tagging outer bands signals potential exhaustion and mean reversion."
        },
        {
          "abbr": "RSI",
          "full": "Relative Strength Index",
          "desc": "Oversold on lower-band tag (bull), overbought on upper-band tag (bear)."
        },
        {
          "abbr": "VOL",
          "full": "Volume Spike",
          "desc": "Volume surge on the reversal candle."
        },
        {
          "abbr": "CLOSE",
