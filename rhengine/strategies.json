    "residualmomentum": {
      "id": "residualmomentum",
      "name": "Residual Momentum",
      "description": "OLS-strips SPY beta to isolate idiosyncratic alpha momentum; 2-bar hold plus EMA and RSI confirmation. Auto-routed in uptrend and downtrend regimes.",
      "regime": "uptrend|downtrend",
      "legs": [
        {
          "abbr": "RA-RES",
