{
  "_spec_version": 1,
  "_notes": "Canonical strategy spec \u2014 single source of truth shared by RobinhoodAgent (Python) and Nydex (JS). Threshold defaults are RobinhoodAgent's walk-forward-tuned values (they win over Nydex UI defaults where they differ, e.g. bollinger adxMax 35). legs/slider metadata come from Nydex for its UI. exits = global exit engine params (RobinhoodAgent order_plan/backtest).",
  "regime_routing": {
    "uptrend": "residualmomentum",
    "downtrend": "residualmomentum",
    "choppy": "bollinger",
    "_note": "MACD retired from auto-routing: no OOS edge in uptrends (optimize.py walk-forward). Still available manually."
  },
  "exits": {
    "stop_atr_mult": 1.5,
    "target_atr_mult": 2.0,
    "trail_trigger_mult": 1.5,
    "chandelier_atr_mult": 3.0,
    "max_hold_sessions": 10,
    "leveraged_max_hold_sessions": 3
  },
  "external_legs": {
    "_note": "Adapter-derived gating legs evaluated OUTSIDE score_ticker — indicators.py stays a pure OHLCV scorer and the golden vectors never move. GateBook today wires only av_earnings_sue + macro_flags (annotate/filter via config.json external_gates). kalshi_prob_shift / polymarket_implied_prob are defined here and scoreable via their adapters / data_source paths, but are NOT yet applied by GateBook — treat as experimental until wired. Scorers: market_data_av.sue_gate, market_data_kalshi.score_prob_shift, market_data_polymarket.score_implied_prob. Additive to the spec — not part of any strategy's legMask bit-width.",
    "kalshi_prob_shift": {
      "id": "kalshi_prob_shift",
      "abbr": "KAL-SHIFT",
      "full": "Kalshi Implied-Probability Shift",
      "desc": "The matching Kalshi market repriced by >= minShift over the last `window` daily bars — event-market information flow the equity tape may not have digested. Direction of the shift must agree with the setup's direction.",
      "thresholds": {
        "window": {
          "default": 5,
          "min": 1,
          "max": 20,
          "step": 1,
          "label": "Shift Window (bars)"
        },
        "minShift": {
          "default": 0.05,
          "min": 0.01,
          "max": 0.3,
          "step": 0.01,
          "label": "Min Probability Shift"
        }
      }
    },
    "av_earnings_sue": {
      "id": "av_earnings_sue",
      "abbr": "SUE",
      "full": "Real Earnings Surprise (AlphaVantage)",
      "desc": "A REAL earnings report (AlphaVantage EARNINGS feed) inside the PEAD drift window with |surprisePercentage| >= minSurprisePct, direction matching the setup. Confirms the price-proxy EVENT leg with actual SUE data — the upgrade path the PEAD spec names. Scorer: market_data_av.sue_gate.",
      "thresholds": {
        "driftMin": {
          "default": 1,
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Drift Min (days)"
        },
        "driftMax": {
          "default": 10,
          "min": 5,
          "max": 20,
          "step": 1,
          "label": "Drift Max (days)"
        },
        "minSurprisePct": {
          "default": 5.0,
          "min": 0.0,
          "max": 25.0,
          "step": 0.5,
          "label": "Min |Surprise| %"
        }
      }
    },
    "polymarket_implied_prob": {
      "id": "polymarket_implied_prob",
      "abbr": "PM-PROB",
      "full": "Polymarket Implied Probability Band",
      "desc": "The matching Polymarket market's implied probability sits in the tradable band (minProb..maxProb — near 0/1 there is no repricing left) and, when minShift > 0, has moved by at least minShift over `window` bars in the setup's direction.",
      "thresholds": {
        "minProb": {
          "default": 0.1,
          "min": 0.0,
          "max": 0.5,
          "step": 0.05,
          "label": "Min Implied Probability"
        },
        "maxProb": {
          "default": 0.9,
          "min": 0.5,
          "max": 1.0,
          "step": 0.05,
          "label": "Max Implied Probability"
        },
        "window": {
          "default": 5,
          "min": 1,
          "max": 20,
          "step": 1,
          "label": "Shift Window (bars)"
        },
        "minShift": {
          "default": 0.0,
          "min": 0.0,
          "max": 0.3,
          "step": 0.01,
          "label": "Min Probability Shift (0=off)"
        }
      }
    }
  },
  "strategies": {
    "vwap": {
      "id": "vwap",
      "name": "VWAP Confluence",
      "description": "Anchored-VWAP reclaim/rejection, EMA trend stack, volume confirmation, RSI momentum reset. Best in trending conditions.",
      "regime": null,
      "legs": [
        {
          "abbr": "VWAP",
          "full": "Anchored Volume Weighted Average Price",
          "desc": "VWAP anchored at the most recent swing extreme. A reclaim above signals bullish bias; a rejection signals bearish."
        },
        {
          "abbr": "EMA",
          "full": "Exponential Moving Average",
          "desc": "Bullish stack = 9 EMA > 21 EMA > 50 EMA. Bearish is the inverse."
        },
        {
          "abbr": "VOL",
          "full": "Volume Spike",
          "desc": "Current bar volume vs the 20-bar average."
        },
        {
          "abbr": "RSI",
          "full": "Relative Strength Index",
          "desc": "Reset = RSI dipped under the midline then crossed back above."
        }
      ],
      "thresholds": {
        "volMult": {
          "default": 1.15,
          "min": 1.0,
          "max": 2.0,
          "step": 0.05,
          "label": "Volume Threshold"
        },
        "rsiLow": {
          "default": 50,
          "min": 40,
          "max": 60,
          "step": 1,
          "label": "RSI Midline"
        },
        "rsiHigh": {
          "default": 70,
          "min": 60,
          "max": 85,
          "step": 1,
          "label": "RSI Ceiling"
        },
        "vwapAnchorLookback": {
          "default": 30,
          "min": 10,
          "max": 60,
          "step": 5,
          "label": "VWAP Anchor Lookback"
        },
        "stopAtrMult": {
          "default": 1.5,
          "min": 0.5,
          "max": 3.0,
          "step": 0.25,
          "label": "Stop (ATR mult)"
        },
        "targetAtrMult": {
          "default": 2.5,
          "min": 1.0,
          "max": 4.0,
          "step": 0.25,
          "label": "Target (ATR mult)"
        },
        "stageFilter": {
          "default": 0,
          "min": 0,
          "max": 1,
          "step": 1,
          "label": "Stage Filter (150d SMA)"
        }
      }
    },
    "bollinger": {
      "id": "bollinger",
      "name": "Bollinger Band Mean Reversion",
      "description": "Band tag + RSI exhaustion + close back inside with volume. Hard-gated by ADX; choppy/range markets only.",
